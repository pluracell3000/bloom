# Bloom hosted deployment (Vercel) configuration.
# Set the secret values as Sensitive, Production-only environment variables in
# the Vercel project. Never commit real values, never scope secrets to
# Preview/Development, and never expose them to the browser bundle.

# --- secrets (Vercel Sensitive variables, Production only) ---
BLOOM_GEMINI_API_KEY=        # Gemini API key from AI Studio (free tier)
BLOOM_WHATSAPP_APP_SECRET=   # Meta app secret, signs webhook payloads
BLOOM_WHATSAPP_VERIFY_TOKEN= # random string you invent for Meta's challenge
BLOOM_READER_KEY=            # random string you invent; opens the private feed
BLOB_READ_WRITE_TOKEN=       # injected automatically by the Vercel Blob store

# --- ordinary runtime config (not secret) ---
BLOOM_GEMINI_MODEL=gemini-2.5-flash  # pick against the project's live free-tier quota
